{
    // The programs come from the Debug static build with tests and apps: run
    // "CMake: ctest" > Debug > static library first; folder
    // build/<hollow.toolchain>-Debug-static.
    // The entries use the MSVC debugger (cppvsdbg); for GDB (gcc on Windows,
    // or Linux) use "type": "cppdbg", "MIMode": "gdb" (no ".exe" on Linux), map
    // "/hollow" instead of "\hollow".
    //
    // hollow's debug info names its sources \hollow\src\... (the same on every
    // PC); "sourceFileMap" points that root at the folder holding them: this
    // checkout, or an installed Debug package (it ships src/).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: hollow_app",
            "type": "cppvsdbg",
            "request": "launch",
            "sourceFileMap": { "\\hollow": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/${config:hollow.toolchain}-Debug-static/bin/hollow_app.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${config:hollow.toolchain}-Debug-static/bin",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Tests: hollow_tests",
            "type": "cppvsdbg",
            "request": "launch",
            "sourceFileMap": { "\\hollow": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/${config:hollow.toolchain}-Debug-static/bin/hollow_tests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/${config:hollow.toolchain}-Debug-static/bin",
            "environment": [],
            "console": "integratedTerminal"
        }
    ]
}
