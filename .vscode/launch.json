{
    // Run and Debug (F5): pick the compiler in the drop-down. Each entry first
    // runs its "Debug build: <compiler>" task (tasks.json), which configures
    // and builds the library, tests and game in build/<compiler>-Debug, then
    // starts the program from there. The game reads assets/ next to it.
    //
    //   MSVC  - the Visual Studio debugger (cppvsdbg)
    //   GCC   - GDB (cppdbg), from w64devkit on the PATH
    //
    // Both debuggers come with the C/C++ extension (ms-vscode.cpptools).
    //
    // hollow's debug info names its sources \hollow\src\... (MSVC) or
    // /hollow/src/... (GCC), the same on every PC; "sourceFileMap" points that
    // root at this checkout.
    //
    // The game starts in a 1280 x 720 window here (--windowed). Other options
    // for "args": "--room", "summit", "--set", "cig_count=0" (see README.md).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Game (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Debug build: msvc",
            "sourceFileMap": { "\\hollow": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/msvc-Debug/bin/The Hollow Dawn.exe",
            "args": ["--windowed"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/msvc-Debug/bin",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Game (GCC)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Debug build: gcc",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "sourceFileMap": { "/hollow": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/gcc-Debug/bin/The Hollow Dawn.exe",
            "args": ["--windowed"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/gcc-Debug/bin",
            "environment": [],
            "externalConsole": false,
            "setupCommands": [
                { "description": "Pretty-print STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Tests (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Debug build: msvc",
            "sourceFileMap": { "\\hollow": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/msvc-Debug/bin/hollow_tests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/msvc-Debug/bin",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Tests (GCC)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Debug build: gcc",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "sourceFileMap": { "/hollow": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/gcc-Debug/bin/hollow_tests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/gcc-Debug/bin",
            "environment": [],
            "externalConsole": false,
            "setupCommands": [
                { "description": "Pretty-print STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
