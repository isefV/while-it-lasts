{
    // Explorer: hidden entries are true. Set an entry to false to show that
    // item again (this also brings it back into search).
    "files.exclude": {
        ".git": true,
        "build": false,
        "install": true,
        "extern": false
    },

    // The build is driven by the CMake tasks (tasks.json), which ask for the
    // compiler each time; CMake Tools, if installed, doesn't configure on
    // its own. Its "CMake: Select a Kit" offers the kits in cmake-kits.json,
    // named like the tasks' toolchains, and it builds in the same folders
    // as the tasks.
    "cmake.useCMakePresets": "never",
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build/${buildKit}-${buildType}"
}
