{
    // hollow tasks: "Terminal > Run Task..." (Ctrl+Shift+B = CMake: build).
    // Each task is a short chain of plain cmake / ctest commands and asks:
    //
    //   Debug | Release  >  static library | shared library
    //
    // Folders: build/<hollow.toolchain>-<Debug|Release>-<static|shared> (programs
    // in its bin/), packages in install/<hollow.toolchain>/<static|shared>.
    // The compiler comes from "hollow.toolchain" in settings.json; the files in
    // .vscode/cmake/ turn the choices into CMake settings (-C <file>).
    //
    // Every build first runs the configure step: it creates the folder the
    // first time and takes a few seconds afterwards.
    //
    // Windows: the tasks run in PowerShell, which first loads the Visual
    // Studio developer environment (compiler, CMake and Ninja), so no
    // Developer Command Prompt is needed. A failing step stops the chain
    // (the cmake function below; Windows PowerShell has no "&&").
    // Linux: bash -e, which also stops at the first failing step.
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-Command",
                    "$installer = Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'Microsoft Visual Studio\\Installer';",
                    "$vs = & (Join-Path $installer 'vswhere.exe') -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath;",
                    "$env:PATH += ';' + $installer;",
                    "Import-Module (Join-Path $vs 'Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll');",
                    "Enter-VsDevShell -VsInstallPath $vs -SkipAutomaticLocation -DevCmdArguments '-arch=x64 -host_arch=x64' | Out-Null;",
                    "function cmake { & (Get-Command cmake -CommandType Application)[0].Source @args; if ($LASTEXITCODE) { exit $LASTEXITCODE } };"
                ]
            },
            "env": { "CMAKE_GENERATOR": "Ninja" }
        }
    },
    "linux": {
        "options": { "shell": { "executable": "bash", "args": [ "-e", "-c" ] } }
    },
    "osx": {
        "options": { "shell": { "executable": "bash", "args": [ "-e", "-c" ] } }
    },
    "tasks": [
        {
            "label": "CMake: configure",
            "detail": "Configure the build folder from scratch (new CMake cache)",
            "type": "shell",
            "command": "cmake -E rm -f build/${config:hollow.toolchain}-${input:config}-${input:linkage}/CMakeCache.txt; cmake -S . -B build/${config:hollow.toolchain}-${input:config}-${input:linkage} -C .vscode/cmake/${config:hollow.toolchain}.cmake -C .vscode/cmake/${input:linkage}.cmake -DCMAKE_BUILD_TYPE=${input:config}",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "detail": "Configure, then build the library",
            "type": "shell",
            "command": "cmake -S . -B build/${config:hollow.toolchain}-${input:config}-${input:linkage} -C .vscode/cmake/${config:hollow.toolchain}.cmake -C .vscode/cmake/${input:linkage}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${config:hollow.toolchain}-${input:config}-${input:linkage} --config ${input:config} --target hollow",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "CMake: rebuild",
            "detail": "Configure, clean, then build the library again",
            "type": "shell",
            "command": "cmake -S . -B build/${config:hollow.toolchain}-${input:config}-${input:linkage} -C .vscode/cmake/${config:hollow.toolchain}.cmake -C .vscode/cmake/${input:linkage}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${config:hollow.toolchain}-${input:config}-${input:linkage} --config ${input:config} --target hollow --clean-first",
            "group": "build",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "CMake: clean",
            "detail": "Delete the build outputs, keep the configuration",
            "type": "shell",
            "command": "cmake --build build/${config:hollow.toolchain}-${input:config}-${input:linkage} --config ${input:config} --target clean",
            "problemMatcher": []
        },
        {
            "label": "CMake: install",
            "detail": "Build the library and install it to install/<toolchain>/<linkage>",
            "type": "shell",
            "command": "cmake -S . -B build/${config:hollow.toolchain}-${input:config}-${input:linkage} -C .vscode/cmake/${config:hollow.toolchain}.cmake -C .vscode/cmake/${input:linkage}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${config:hollow.toolchain}-${input:config}-${input:linkage} --config ${input:config} --target hollow; cmake --install build/${config:hollow.toolchain}-${input:config}-${input:linkage} --config ${input:config} --prefix install/${config:hollow.toolchain}/${input:linkage}",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "CMake: ctest",
            "detail": "Build the library, tests and apps, and run all CTest tests",
            "type": "shell",
            "command": "cmake -S . -B build/${config:hollow.toolchain}-${input:config}-${input:linkage} -C .vscode/cmake/${config:hollow.toolchain}.cmake -C .vscode/cmake/${input:linkage}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${config:hollow.toolchain}-${input:config}-${input:linkage} --config ${input:config}; ctest --test-dir build/${config:hollow.toolchain}-${input:config}-${input:linkage} -C ${input:config} --output-on-failure --timeout 300",
            "group": "test",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        }
    ],
    "inputs": [
        {
            "id": "config",
            "type": "pickString",
            "description": "Configuration",
            "default": "Debug",
            "options": [ "Debug", "Release" ]
        },
        {
            "id": "linkage",
            "type": "pickString",
            "description": "Library type",
            "default": "static",
            "options": [
                { "label": "static library", "value": "static" },
                { "label": "shared library", "value": "shared" }
            ]
        }
    ]
}
