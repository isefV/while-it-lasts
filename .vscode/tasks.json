{
    // hollow tasks: "Terminal > Run Task..." (Ctrl+Shift+B = CMake: build).
    // Each task is a short chain of plain cmake / ctest commands and asks:
    //
    //   msvc | gcc | clang     then     Debug | Release
    //
    // Folders: build/<toolchain>-<Debug|Release> (programs in its bin/),
    // packages in install/<toolchain>.
    // The files in .vscode/cmake/ turn the toolchain into CMake settings
    // (-C <file>); a new file there needs its name added to "toolchain" below.
    //
    // Every build first runs the configure step: it creates the folder the
    // first time and takes a few seconds afterwards.
    //
    // Windows: the tasks run in PowerShell, which first loads the Visual
    // Studio developer environment (compiler, CMake and Ninja), so no
    // Developer Command Prompt is needed. A failing step stops the chain
    // (the cmake function below; Windows PowerShell has no "&&").
    // Linux: bash -e, which also stops at the first failing step.
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-Command",
                    "$installer = Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'Microsoft Visual Studio\\Installer';",
                    "$vs = & (Join-Path $installer 'vswhere.exe') -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath;",
                    "$env:PATH += ';' + $installer;",
                    "Import-Module (Join-Path $vs 'Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll');",
                    "Enter-VsDevShell -VsInstallPath $vs -SkipAutomaticLocation -DevCmdArguments '-arch=x64 -host_arch=x64' | Out-Null;",
                    "function cmake { & (Get-Command cmake -CommandType Application)[0].Source @args; if ($LASTEXITCODE) { exit $LASTEXITCODE } };"
                ]
            },
            "env": { "CMAKE_GENERATOR": "Ninja" }
        }
    },
    "linux": {
        "options": { "shell": { "executable": "bash", "args": [ "-e", "-c" ] } }
    },
    "osx": {
        "options": { "shell": { "executable": "bash", "args": [ "-e", "-c" ] } }
    },
    "tasks": [
        {
            "label": "Configure",
            "detail": "Configure the build folder from scratch (new CMake cache)",
            "type": "shell",
            "command": "cmake -E rm -f build/${input:toolchain}-${input:config}/CMakeCache.txt; cmake -S . -B build/${input:toolchain}-${input:config} -C .vscode/cmake/${input:toolchain}.cmake -DCMAKE_BUILD_TYPE=${input:config}",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "detail": "Configure, then build the library",
            "type": "shell",
            "command": "cmake -S . -B build/${input:toolchain}-${input:config} -C .vscode/cmake/${input:toolchain}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${input:toolchain}-${input:config} --config ${input:config} --target hollow",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "Build game",
            "detail": "Configure, then build the game (While It Lasts.exe, with the library and assets) in build/<toolchain>-<config>/bin",
            "type": "shell",
            "command": "cmake -S . -B build/${input:toolchain}-${input:config} -C .vscode/cmake/${input:toolchain}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${input:toolchain}-${input:config} --config ${input:config} --target game",
            "group": "build",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "Rebuild",
            "detail": "Configure, clean, then build the library again",
            "type": "shell",
            "command": "cmake -S . -B build/${input:toolchain}-${input:config} -C .vscode/cmake/${input:toolchain}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${input:toolchain}-${input:config} --config ${input:config} --target hollow --clean-first",
            "group": "build",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "Clean",
            "detail": "Delete the build outputs, keep the configuration",
            "type": "shell",
            "command": "cmake --build build/${input:toolchain}-${input:config} --config ${input:config} --target clean",
            "problemMatcher": []
        },
        {
            "label": "Install",
            "detail": "Build the library and install it to install/<toolchain>",
            "type": "shell",
            "command": "cmake -S . -B build/${input:toolchain}-${input:config} -C .vscode/cmake/${input:toolchain}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${input:toolchain}-${input:config} --config ${input:config} --target hollow; cmake --install build/${input:toolchain}-${input:config} --config ${input:config} --prefix install/${input:toolchain}",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "Ctest",
            "detail": "Build the library, tests and apps, and run all CTest tests",
            "type": "shell",
            "command": "cmake -S . -B build/${input:toolchain}-${input:config} -C .vscode/cmake/${input:toolchain}.cmake -DCMAKE_BUILD_TYPE=${input:config}; cmake --build build/${input:toolchain}-${input:config} --config ${input:config}; ctest --test-dir build/${input:toolchain}-${input:config} -C ${input:config} --output-on-failure --timeout 300",
            "group": "test",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            // Used by launch.json (preLaunchTask): everything, Debug, with MSVC.
            "label": "Debug build: msvc",
            "detail": "Configure and build the library, tests and game (Debug) with MSVC, in build/msvc-Debug",
            "type": "shell",
            "command": "cmake -S . -B build/msvc-Debug -C .vscode/cmake/msvc.cmake -DCMAKE_BUILD_TYPE=Debug; cmake --build build/msvc-Debug --config Debug",
            "problemMatcher": [ "$msCompile" ]
        },
        {
            // Used by launch.json (preLaunchTask): everything, Debug, with GCC.
            "label": "Debug build: gcc",
            "detail": "Configure and build the library, tests and game (Debug) with GCC, in build/gcc-Debug",
            "type": "shell",
            "command": "cmake -S . -B build/gcc-Debug -C .vscode/cmake/gcc.cmake -DCMAKE_BUILD_TYPE=Debug; cmake --build build/gcc-Debug --config Debug",
            "problemMatcher": [ "$gcc" ]
        }
    ],
    "inputs": [
        {
            "id": "toolchain",
            "type": "pickString",
            "description": "Compiler (a file in .vscode/cmake/)",
            "default": "msvc",
            "options": [
                { "label": "msvc   (Visual Studio cl)", "value": "msvc" },
                { "label": "gcc    (g++ on PATH, e.g. MinGW)", "value": "gcc" },
                { "label": "clang  (clang++ on PATH)", "value": "clang" }
            ]
        },
        {
            "id": "config",
            "type": "pickString",
            "description": "Configuration",
            "default": "Debug",
            "options": [ "Debug", "Release" ]
        }
    ]
}
