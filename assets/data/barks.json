// Short lines over a character's head (script, appendix A). A room's
// "idle_barks" plays one when the player stands still for a while; a pool
// never repeats the same line back to back. An entry in "lines" is one line
// or a short exchange [ {...}, {...} ].
{
    "y_idle": {
        "lines": [
            { "y": "Still no signal. Surprise." },
            { "y": "I'd kill for a hot meal right now." },
            { "y": "If this is a test, I'd like to see the rubric." }
        ]
    },
    "x_idle_good": {
        "if": "x_condition >= 2",
        "lines": [
            { "x": "{y}. Are we there yet?" },
            { "x": "I'd complain, but I'm saving it for the stairs." },
            { "x": "Not that I'm tired. I'm just resting my eyes. Aggressively." }
        ]
    },
    "x_idle_weak": {
        "if": "x_condition <= 1",
        "lines": [
            { "x": "It's okay. Keep going." },
            { "x": "I'm here. Just slow." },
            { "x": "Talk to me about something. Anything." }
        ]
    },
    "y_hurt": {
        "if": "y_health <= 2",
        "lines": [
            { "y": "Everything hurts. Fine. Everything's fine." },
            { "y": "I should wrap that. Later." },
            [ { "x": "You're limping." }, { "y": "I'm walking with character." } ]
        ]
    },
    "x_hurt": {
        "lines": [
            { "x": "Ah! It got me." },
            { "x": "{y}! Little help!" },
            { "x": "Get it off, get it off!" }
        ]
    },
    "x_reaper": {
        "lines": [
            { "x": "It's still back there, isn't it?" },
            { "x": "Look at it. It doesn't like being looked at." },
            { "x": "Keep walking. It only comes when we stop." },
            [ { "x": "Do you see it?" }, { "y": "Yeah." }, { "x": "Good. I didn't want to be the only one." } ]
        ]
    },
    "x_reaper_close": {
        "lines": [
            { "x": "{y}. It's close. It touched my hand." },
            { "x": "Cold. So cold. Don't stop again." },
            { "x": "It was right there. Keep moving." }
        ]
    },
    "hide": {
        "lines": [
            [ { "x": "Don't breathe." }, { "y": "I'm not." } ],
            [ { "x": "You're breathing loud." }, { "y": "I'm breathing normal." } ]
        ]
    }
}
