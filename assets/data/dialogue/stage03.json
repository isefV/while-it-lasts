// STAGE 03: THE MOUNTAIN STEPS. Lines are the script's; "_added" marks new
// ones, including variants of X's lines for a low X_CONDITION (appendix B:
// quiet, breaks off mid-sentence). The Collapse holds the second near-death
// scene (harder than the barricade's); from there X is dragged, and G lets go
// of him and takes hold again.
{
    "foot.arrive": [
        { "x": "You've got to be kidding me." },
        { "y": "You said it was up here." },
        { "x": "I said \"somewhere up here.\" Not a thousand stairs." },
        { "y": "Want to turn back?" },
        { "x": "And go where? The charming factory?" },
        { "narration": "{y} offers his arm. {x} takes it." },
        { "x": "Fine. But if I die, I'm blaming the stairs." },
        { "y": "Noted." },
        { "thought": "I wish he'd stop saying that." }
    ],

    "foot.lantern": [
        { "y": "Somebody left a coin in this one. For luck.", "_added": "new thing to look at" },
        { "x": "Or for the toll." },
        { "y": "Don't." }
    ],
    "foot.lantern_broken": [
        { "y": "This one's broken clean through. We didn't do that, right?", "_added": "new thing to look at" },
        { "x": "You did that. Summer we were twelve." },
        { "y": "...Oh. Yeah." }
    ],
    "foot.stream": [
        { "narration": "{y} cups water for {x}. He drinks like he's never seen it before.", "_added": "new thing to look at" },
        { "x": "I'm hydrating. It's called self-care." }
    ],
    "foot.stream_again": [
        { "thought": "Cold enough to hurt your teeth. Same as always.", "_added": "second look" }
    ],
    "foot.shrine": [
        { "y": "Fresh flowers. Somebody still comes up here.", "_added": "new thing to look at" },
        { "x": "Or something does." },
        { "narration": "Neither of them looks back down the path." }
    ],

    "landing.footprints": [
        { "y": "Footprints behind us. Ours.", "_added": "new thing to look at: the Reaper follows" },
        { "y": "And longer ones. That stop when ours stop." },
        { "x": "Keep walking." }
    ],

    "landing.lantern": [
        { "y": "This one used to light up in summer. Remember?" },
        { "if": "x_condition <= 1",
          "then": [ { "x": "I remember you... tripping. Over it.", "_added": "low condition variant" } ],
          "else": [ { "x": "I remember you tripping over it." } ] }
    ],
    "landing.ribbon": [
        { "x": "You tied that one, didn't you?" },
        { "y": "You said it was stupid." },
        { "x": "It was stupid." },
        { "y": "You kept yours." },
        { "x": "I have terrible taste." },
        { "narration": "{y} smiles faintly." }
    ],
    "landing.marker": [
        { "y": "Our initials are still here." },
        { "x": "Barely. We carved them with a spoon." },
        { "y": "A spoon and a rock." },
        { "x": "Craftsmanship." }
    ],
    "landing.sign": [
        { "y": "\"Summit,\" arrow, and a missing letter." },
        { "if": "x_condition <= 1",
          "then": [ { "x": "Still... more reliable than you.", "_added": "low condition variant" } ],
          "else": [ { "x": "Honestly more reliable than your directions." } ] }
    ],

    "collapse.fall": [
        { "narration": "{x} stumbles and {y} catches him.", "do": ["pose x sit"] },
        { "y": "Hey! Look at me." },
        { "x": "I'm fine." },
        { "y": "You're not." },
        { "x": "Then stop asking stupid questions." },
        { "narration": "His eyes slide past {y}, to something behind him. Then they roll back, and he goes limp.", "do": ["pose x lying", "music stop", "ambient wind@0.5"], "_added": "the second near-death scene, worse than the barricade" },
        { "do": ["revive collapse.revived 10 12"] }
    ],
    "collapse.revived": [
        { "if": "reaper_touched >= 1",
          "then": [ { "narration": "{x} comes back slower this time, like he had to be talked into it.", "_added": "" } ],
          "else": [ { "narration": "{x} jerks back into his body with a ragged breath.", "_added": "" } ] },
        { "x": "...It was closer. This time.", "_added": "" },
        { "y": "I know. I saw." },
        { "x": "Get me up there, {y}. That's all I want. That was the deal." },
        { "y": "That's still the deal." },
        { "do": ["music music_mountain", "ambient wind footsteps leaves", "reaper follow 100", "pose x sit"] },
        { "narration": "{y} tries to stand him up. {x} cries out." },
        { "y": "We have to keep going." },
        { "x": "No." },
        { "y": "What do you mean, \"no\"?" },
        { "x": "You have to keep going. I'll catch up." },
        { "y": "Don't do that." },
        { "x": "{y}..." },
        { "y": "No." },
        { "x": "Then what, you'll drag me up the whole mountain?" },
        { "narration": "{y} kneels and takes hold of him.", "do": ["pose y kneel"] },
        { "y": "Yes." },
        { "narration": "{x} gives a weak, disbelieving laugh." },
        { "x": "You're such an idiot." },
        { "y": "You've mentioned it." },
        { "narration": "Walk to pull {x} along. Rest where you can. G lets go of him, and takes hold again.", "_added": "how dragging works" },
        { "do": ["x_down = true", "companion drag"] }
    ],
    "collapse.edge": [
        { "y": "Long way down. Longer than I remember.", "_added": "new thing to look at" },
        { "if": "x_here", "then": [ { "x": "Everything's longer than you remember. You have a bad memory." } ] }
    ],

    "collapse.narrow": [
        { "thought": "Too narrow to pull him through like this.", "_added": "a passage that needs X repositioned" },
        { "choice": [
            { "text": "Turn him and go sideways.", "do": ["turned_x = true"], "next": "collapse.turned" },
            { "text": "Not yet." }
        ] }
    ],
    "collapse.turned": [
        { "narration": "{y} shifts {x} around, slow and careful, and edges into the gap sideways.", "_added": "" },
        { "x": "Ow. Okay. Ow." }
    ],

    "mountain.rest": [
        { "narration": "{y} lowers {x} for a moment.", "_added": "" },
        { "if": "rests == 0", "then": [
            { "x": "Give me a second. I'm just... admiring the view of my own knees." }
        ] },
        { "if": "rests == 1", "then": [
            { "x": "Do you remember when we used to run this in under ten minutes?" },
            { "y": "We never ran this in under ten minutes." },
            { "x": "In my head we did." }
        ] },
        { "if": "rests == 2", "then": [
            { "x": "{y}. Thanks. For not leaving me." },
            { "y": "Don't thank me yet. We're not there." }
        ] },
        { "if": "rests == 3", "then": [
            { "x": "(very quiet) Is it still far?" },
            { "y": "Not really. Just a bit more." },
            { "x": "You always say that." },
            { "y": "And I'm always right." }
        ] },
        { "do": ["rests += 1", "y_health += 1"] }
    ],
    "mountain.not_without": [
        { "thought": "Not without him.", "_added": "" }
    ],

    "stairs.safe_hint": [
        { "narration": "A creature blocks the collapsed stairs ahead." },
        { "thought": "Behind that wall, he'd be out of its sight. (G lets go of him.)", "_added": "where to leave X" }
    ],
    "stairs.release": [
        { "if": "!stairs_left_x && !creature_cleared", "then": [
            { "y": "Stay here.", "do": ["stairs_left_x = true"] },
            { "x": "Wasn't planning on going anywhere." },
            { "y": "I mean it. Don't move." },
            { "x": "You say that like I've got a choice." }
        ] },
        { "if": "!creature_cleared", "do": ["reaper show 50 80 5"], "_added": "left alone, X has company" }
    ],
    "stairs.grab": [
        { "do": ["reaper hide 1"] },
        { "if": "beam_moved && !stairs_back", "then": [ { "goto": "stairs.back" } ] }
    ],
    "stairs.cant_drag": [
        { "thought": "Not with him on my back. Not past that. (G lets go of him.)", "_added": "" }
    ],
    "stairs.claws": [
        { "y": "Scratches in the stone. Over and over, in the same place.", "_added": "new thing to look at" },
        { "thought": "Like it's been waiting here a long time." }
    ],
    "stairs.creature": [
        { "narration": "It turns its head toward {y}.", "_added": "the mountain creature (the script has no lines for it)" },
        { "choice": [
            { "text": "Throw a rock down the slope.", "next": "stairs.distract" },
            { "text": "Fight it.", "if": "item.bat || (item.pistol && ammo >= 1)", "next": "stairs.fight" },
            { "timeout": true, "next": "stairs.charge" }
        ], "timer": 6 }
    ],
    "stairs.distract": [
        { "narration": "The rock clatters down the slope. The creature follows the sound into the dark.", "do": ["sound clatter", "creature_cleared = true", "event creature_leave 360"], "_added": "" }
    ],
    "stairs.fight": [
        { "narration": "{y} grips the bat. Behind him, down the path, something small skitters on the stones.", "_added": "the fight: a wave first, then the creature" },
        { "do": ["fight"] }
    ],
    "stairs.charge": [
        { "narration": "It comes at {y}. And behind him, down the path, something small skitters on the stones.", "do": ["sound roar", "shake 0.4 2"], "_added": "too slow: the fight anyway" },
        { "do": ["fight"] }
    ],
    "stairs.fight_won": [
        { "narration": "It reels, and slinks off down the mountain.", "do": ["creature_cleared = true"], "_added": "" },
        { "y": "Okay. Still here." }
    ],
    "stairs.fight_lost": [
        { "narration": "{y} goes down hard. It stands over him, sniffs, and loses interest. It lumbers off down the slope.", "do": ["creature_cleared = true", "event creature_leave -60"], "_added": "losing: it leaves anyway, never game over" },
        { "y": "Okay. Still... here." }
    ],
    "stairs.beam": [
        { "if": "!creature_cleared",
          "then": [ { "thought": "Not with that thing watching.", "_added": "" } ],
          "else": [ { "narration": "{y} braces against the beam and shoves. It scrapes aside.", "do": ["beam_moved = true", "sound scrape"] } ] }
    ],
    "stairs.back": [
        { "narration": "{x} is barely awake.", "do": ["stairs_back = true", "reaper hide 1"] },
        { "y": "Hey. I'm back." },
        { "x": "Took you long enough." },
        { "y": "Did you miss me?" },
        { "x": "Like a hole in the head." },
        { "y": "Wow. Even now." },
        { "x": "Especially now." },
        { "narration": "{y} helps him up and starts dragging again.", "do": ["companion drag"] }
    ],
    "stairs.x": [
        { "if": "beam_moved",
          "then": [
            { "if": "!stairs_back", "then": [ { "goto": "stairs.back" } ] },
            { "do": ["reaper hide 1", "companion drag"] }
          ],
          "else": [
            { "if": "creature_cleared",
              "then": [
                { "x": "Is it gone?", "_added": "" },
                { "y": "It's gone. The way's still blocked." }
              ],
              "else": [
                { "x": "Go. I'm not going anywhere.", "_added": "" }
              ] }
          ] }
    ],

    "ascent.sky": [
        { "y": "The sky's going grey at the edges. Then gold.", "_added": "new thing to look at: sunrise" },
        { "x": "Told you. Sunrise. I planned this." },
        { "y": "You did not plan this." },
        { "x": "...I planned some of it." }
    ],

    "ascent.talk": [
        { "x": "Remember the first time we came up here?" },
        { "y": "You got us lost." },
        { "x": "I did not." },
        { "y": "Three hours, {x}. Three." },
        { "x": "Because you insisted you knew the way." },
        { "y": "I did know the way." },
        { "x": "We ended up in someone's backyard." },
        { "y": "That was a shortcut." },
        { "x": "There was a dog." },
        { "y": "A very friendly dog." },
        { "narration": "{x} laughs weakly." },
        { "x": "We were happy here. Weren't we?" },
        { "narration": "{y} keeps pulling." },
        { "y": "Yeah." },
        { "x": "Even when everything else was a mess." },
        { "y": "Especially then." },
        { "narration": "{x} rests his head against {y}'s shoulder." },
        { "x": "I miss that." },
        { "y": "We're almost there." },
        { "x": "I know." },
        { "narration": "The last stretch of path comes into view." },
        { "y": "We're close. Just a little farther. Come on." },
        { "pause": 1.5 },
        { "narration": "{x} doesn't answer." },
        { "y": "{x}?" },
        { "pause": 1.2, "do": ["sound breath"] },
        { "narration": "A faint breath." },
        { "narration": "{y} adjusts his grip and keeps walking." }
    ]
}
