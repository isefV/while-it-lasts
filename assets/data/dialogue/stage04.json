// STAGE 04: THE SUMMIT. Lines are the script's; "_added" marks new ones.
// Branches: a saved cigarette or none (CIG_COUNT), two or more shared
// (SMOKED_WITH_X), both factory notes read (notes_read >= 2, the script's
// READ_ALL_NOTES). The room's script starts "summit.reaper".
{
    "summit.arrive": [
        { "narration": "{y} lowers {x} onto a flat rock. Below them lies their town.", "do": ["pose x sit"] },
        { "y": "There. Made it." },
        { "narration": "{y} catches his breath." },
        { "y": "Told you we would." },
        { "x": "(eyes opening slowly) Looks the same." },
        { "y": "Yeah." },
        { "x": "I thought it'd look different." },
        { "y": "Different how?" },
        { "x": "I don't know. Smaller?" },
        { "y": "It's a pretty dumb place." },
        { "x": "(faint smile) Yeah. It is." },
        { "pause": 2.0 },
        { "x": "I missed it." },
        { "y": "Me too." },
        { "y": "We should've come back sooner." },
        { "x": "We had stuff going on." },
        { "y": "Still." },
        { "x": "Hey." },
        { "y": "Yeah?" },
        { "x": "We made it." },
        { "y": "(trying to smile) Yeah. We made it." }
    ],

    "summit.ground": [
        { "if": "notes_read >= 2",
          "then": [
            { "y": "Hey, remember that note at the factory? \"Don't let them follow you home.\"" },
            { "x": "I remember." },
            { "y": "I think we did it anyway." },
            { "x": "Maybe it's not following us. Maybe it just wanted to see the view." },
            { "y": "That's not funny." },
            { "x": "It's a little funny." }
          ],
          "else": [
            { "y": "Our old fire ring. Still here.", "_added": "the ground without the notes" }
          ] }
    ],

    "summit.x": [
        { "if": "!cig_scene_done",
          "then": [ { "goto": "summit.cigarette_scene" } ],
          "else": [
            { "y": "Hey. You can sleep when we get home." },
            { "narration": "{x} doesn't respond.", "do": ["summit_moments += 1"] }
          ] }
    ],

    "summit.cigarette_scene": [
        { "do": ["place y 146", "face y right"] },
        { "if": "cig_count >= 1",
          "then": [
            { "narration": "{y} finds the cigarette he saved and looks at it." },
            { "y": "I kept one." },
            { "x": "Selfish." },
            { "y": "Learned from the best." },
            { "x": "(quiet laugh) True." },
            { "narration": "{y} lights it and holds it out. {x} takes it with shaking fingers, inhales weakly, and hands it back.", "do": ["cig_count -= 1", "cig_lit = true", "sound lighter"] }
          ],
          "else": [
            { "narration": "{y} checks his pockets and finds nothing. A small, crumpled cigarette falls from the lining of {x}'s blanket." },
            { "x": "I was saving that." },
            { "y": "You were saving one?" },
            { "x": "It was for a special occasion." },
            { "y": "Well." },
            { "x": "Yeah. Well." },
            { "narration": "{y} lights it. They share it.", "do": ["cig_lit = true", "sound lighter"] }
          ] },
        { "x": "You know what's funny?" },
        { "y": "What?" },
        { "x": "All the things we used to worry about." },
        { "y": "School. Money. Getting out of here." },
        { "x": "All our stupid arguments." },
        { "y": "We had some good ones." },
        { "x": "You were always wrong." },
        { "y": "You wish." },
        { "narration": "{x} smiles, then closes his eyes." },
        { "x": "Remember when we said we'd leave together?" },
        { "y": "...Yeah." },
        { "x": "See the whole world." },
        { "y": "We still can." },
        { "narration": "{x} opens his eyes." },
        { "x": "You're a terrible liar." },
        { "y": "Shut up." },
        { "x": "Always have been." },
        { "narration": "{y} laughs, but the sound breaks halfway." },
        { "y": "Come on, man. Don't do this." },
        { "narration": "{x} leans against his shoulder." },
        { "x": "I'm tired." },
        { "y": "I know." },
        { "x": "Just for a minute." },
        { "y": "Okay. Just rest." },
        { "if": "smoked_with_x >= 2", "then": [
            { "x": "Hey. Thanks for all the cigarettes." },
            { "y": "Don't say it like that." },
            { "x": "Like what?" },
            { "y": "Like it's goodbye." },
            { "x": "...It's just a thank-you." }
        ] },
        { "do": ["cig_scene_done = true"] }
    ],

    "summit.horizon": [
        { "y": "We used to think we'd never get out of here.", "do": ["summit_moments += 1"] }
    ],
    "summit.cigarette": [
        { "narration": "{y} takes another drag. The ember flickers in the wind.", "do": ["summit_moments += 1", "sound inhale"] }
    ],

    "summit.reaper": [
        { "do": ["event wind_stop"] },
        { "narration": "The wind stops. The grass and the trees go still." },
        { "pause": 2.0, "do": ["event reaper_appear"] },
        { "narration": "At the edge of the clearing, a tall figure appears. It does not move toward them." },
        { "y": "Remember the place behind the house? Where we used to hide?" },
        { "pause": 1.5 },
        { "narration": "No reply." },
        { "y": "You always said nobody would find us there." },
        { "narration": "A small, broken laugh." },
        { "y": "You were wrong about that too." },
        { "y": "{x}?" },
        { "narration": "{x}'s head slips gently against his shoulder. {y} catches him.", "do": ["pose x lying"] },
        { "y": "Hey." },
        { "narration": "{y} touches {x}'s face." },
        { "y": "Come on. Wake up." },
        { "y": "{x}?" },
        { "narration": "{y} shakes him once. Twice.", "do": ["shake 0.2 1"] },
        { "y": "No. No, no. Come on." },
        { "narration": "{y} presses a hand against the wound, as if there were still something to do." },
        { "y": "I got you here. You wanted to come back. We made it." },
        { "narration": "{y}'s voice breaks." },
        { "y": "You said we made it." },
        { "narration": "{y} pulls {x} close and rests his forehead against his." },
        { "pause": 2.0, "do": ["event spirit_rise"] },
        { "narration": "A faint light rises from {x}. It takes a familiar shape. {y} reaches for it, and his hand passes through." },
        { "pause": 1.5, "do": ["event spirit_to_reaper"] },
        { "narration": "It looks down at him for a last moment, then drifts toward the tall figure." },
        { "pause": 4.0, "do": ["event reaper_vanish"] },
        { "narration": "The figure turns and vanishes into the dark." },
        { "narration": "{y} does not move. The cigarette burns down between his fingers." },
        { "pause": 2.0, "do": ["event final_image"] },
        { "pause": 7.0 },
        { "do": ["end"] }
    ]
}
