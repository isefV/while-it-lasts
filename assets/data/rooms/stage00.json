// STAGE 00 rooms. Positions are scene pixels (320 x 180); the ground line is
// y = 150, and an object without "y" stands on it. Every object is a coloured
// rectangle until its "sprite" file exists.
{
    "campsite": {
        "name": "The Campsite",
        "background": "backgrounds/campsite.png",
        "color": "#18202c",
        "tint": "#c4c8dc",
        // Midnight: no music, only the night (insects, frogs, a far owl) and
        // the fire, low. "fire@0.45" plays that loop at 45 %.
        "ambient": ["jungle_night", "fire@0.45"],
        "script": "campsite",
        "player_x": 118,
        "walk": [8, 312],
        "idle_barks": ["y_idle"],
        "enter": [
            { "dialogue": "campsite.start" }
        ],
        "companion": { "x": 268, "mode": "stay", "pose": "lying", "dialogue": "campsite.x" },
        "objects": [
            { "id": "tree_left",  "x": 0,   "y": 20, "w": 12, "h": 130, "color": "#0f141c", "interactive": false },
            { "id": "tree_left2", "x": 22,  "y": 40, "w": 8,  "h": 110, "color": "#121823", "interactive": false },
            { "id": "tree_right", "x": 288, "y": 24, "w": 10, "h": 126, "color": "#0f141c", "interactive": false },
            { "id": "moon", "name": "The moon", "x": 236, "y": 16, "w": 8, "h": 8, "color": "#b8bece",
              "dialogue": "campsite.moon", "again": "campsite.moon_again" },

            { "id": "jacket", "name": "{x}'s jacket", "x": 14, "y": 96, "w": 10, "h": 16, "color": "#3c4636",
