            { "id": "car", "name": "Broken car", "x": 30, "w": 64, "h": 32, "color": "#2c333d",
              "sprite": "props/car.png", "dialogue": "campsite.car", "again": "campsite.car_again" },
            { "id": "map", "name": "Trail map", "x": 70, "y": 112, "w": 12, "h": 6, "color": "#8a8470",
              "dialogue": "campsite.map", "again": "campsite.map_again" },
            { "id": "backpack", "name": "Backpack", "x": 100, "w": 16, "h": 16, "color": "#4a4f45",
