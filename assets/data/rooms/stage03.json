// STAGE 03 rooms. All use the one mountain background. Audio rule: each
// screen loses one ambient layer; the final ascent has only wind and
// footsteps.
{
    "foot": {
        "name": "Foot of the Mountain",
        "background": "backgrounds/mountain_steps.png",
        "color": "#182027",
        "tint": "#9fa8bc",
        "ambient": ["wind", "footsteps", "leaves", "insects", "stream"],
        "player_x": 24,
        "idle_barks": ["y_idle", "x_idle_good", "x_idle_weak"],
        "enter": [
            { "dialogue": "foot.arrive" }
        ],
        "companion": { "mode": "follow", "bark": "x_idle_good" },
        "objects": [
            { "id": "lantern_1", "x": 70,  "w": 16, "h": 32, "color": "#2e343e", "sprite": "props/lantern.png", "interactive": false },
            { "id": "lantern_2", "x": 150, "w": 16, "h": 20, "color": "#2b3039", "interactive": false },
            { "id": "lantern_3", "x": 230, "w": 16, "h": 32, "color": "#2e343e", "sprite": "props/lantern.png", "interactive": false },
            { "id": "steps", "name": "Stone steps", "x": 300, "y": 70, "w": 20, "h": 80, "color": "#11161c", "exit": "landing" }
        ]
    },

    "landing": {
        "name": "The First Landing",
        "background": "backgrounds/mountain_steps.png",
        "color": "#1a2128",
        "tint": "#9ca4b8",
        "ambient": ["wind", "footsteps", "leaves", "insects"],
        "player_x": 24,
        "idle_barks": ["x_idle_good", "x_idle_weak"],
        "companion": { "mode": "follow", "bark": "x_idle_good" },
        "objects": [
            { "id": "lantern", "name": "Mossy lantern", "x": 56, "w": 16, "h": 32, "color": "#3a4438",
              "sprite": "props/lantern.png", "dialogue": "landing.lantern" },
            { "id": "tree", "x": 110, "y": 20, "w": 20, "h": 130, "color": "#141a20", "interactive": false },
            { "id": "ribbon", "name": "Old ribbon", "x": 124, "y": 78, "w": 10, "h": 14, "color": "#6a5a6a",
              "sprite": "props/ribbon.png", "dialogue": "landing.ribbon" },
            { "id": "stone_marker", "name": "Stone marker", "x": 184, "w": 16, "h": 16, "color": "#4a4e54",
              "sprite": "props/stone_marker.png", "dialogue": "landing.marker" },
            { "id": "broken_sign", "name": "Broken sign", "x": 236, "y": 118, "w": 32, "h": 32, "color": "#4a4236",
              "sprite": "props/broken_sign.png", "dialogue": "landing.sign" },
            { "id": "steps", "name": "Stone steps", "x": 300, "y": 70, "w": 20, "h": 80, "color": "#11161c", "exit": "collapse" }
        ]
    },

    "collapse": {
        "name": "The Collapse",
        "background": "backgrounds/mountain_steps.png",
        "color": "#1b1f27",
        "tint": "#9a9fb4",
        "ambient": ["wind", "footsteps", "leaves"],
        "player_x": 40,
        "idle_barks": ["x_idle_weak"],
        "enter": [
            { "dialogue": "collapse.fall" }
        ],
        "companion": { "mode": "follow" },
        "objects": [
            { "id": "rest_rock", "name": "Flat rock", "x": 96, "y": 142, "w": 26, "h": 8, "color": "#3a3f47",
              "rest": true, "if": "dragging", "once": true, "dialogue": "mountain.rest" },
            { "id": "rock_left", "x": 150, "y": 60, "w": 14, "h": 90, "color": "#151a20", "interactive": false, "front": true },
            { "id": "rock_right", "x": 176, "y": 70, "w": 14, "h": 80, "color": "#151a20", "interactive": false, "front": true },
            { "id": "narrow", "x": 158, "w": 6, "h": 60, "hidden": true, "block": "dragging && !turned_x",
              "blocked": "collapse.narrow" },
            { "id": "rest_stump", "name": "Tree stump", "x": 236, "y": 140, "w": 18, "h": 10, "color": "#3a3530",
              "rest": true, "if": "dragging", "once": true, "dialogue": "mountain.rest" },
            { "id": "steps", "name": "Stone steps", "x": 300, "y": 70, "w": 20, "h": 80, "color": "#11161c",
              "exit": "broken_stairs", "exit_if": "dragging", "locked": "mountain.not_without" }
        ]
    },

    "broken_stairs": {
        "name": "The Broken Stairs",
        "background": "backgrounds/mountain_steps.png",
        "color": "#1c1e26",
        "tint": "#9a9aae",
        "ambient": ["wind", "footsteps", "groan"],
        "script": "creature",
        "player_x": 36,
        "idle_barks": ["x_idle_weak"],
        "companion": { "mode": "drag", "dialogue": "stairs.x" },
        "creature": {
            "if": "!creature_cleared", "x": 226, "y": 150, "w": 34, "h": 54, "speed": 30,
            "color": "#0b0d11", "sprite": "sprites/creature.json"
        },
        "objects": [
            { "id": "low_wall", "x": 70, "y": 124, "w": 30, "h": 26, "color": "#2c3139", "interactive": false, "front": true },
            { "id": "safe_spot", "x": 98, "w": 14, "h": 60, "trigger": true, "if": "dragging && !creature_cleared",
              "dialogue": "stairs.leave_x" },
            { "id": "no_drag", "x": 132, "w": 4, "h": 60, "hidden": true, "block": "dragging && !creature_cleared",
              "blocked": "stairs.cant_drag" },
            { "id": "creature", "name": "Creature", "x": 210, "y": 96, "w": 32, "h": 54, "hidden": true,
              "if": "!creature_cleared", "dialogue": "stairs.creature" },
            { "id": "creature_block", "x": 216, "w": 4, "h": 60, "hidden": true, "block": "!creature_cleared" },
            { "id": "fallen_beam", "name": "Fallen beam", "x": 246, "y": 134, "w": 64, "h": 16, "color": "#3a3128",
              "sprite": "props/fallen_beam.png", "if": "!beam_moved", "block": "!beam_moved", "dialogue": "stairs.beam" },
            { "id": "rest_step", "name": "Mossy step", "x": 262, "y": 144, "w": 22, "h": 6, "color": "#34403a",
              "rest": true, "if": "dragging && beam_moved", "once": true, "dialogue": "mountain.rest" },
            { "id": "steps", "name": "Stone steps", "x": 304, "y": 70, "w": 16, "h": 80, "color": "#11161c",
              "exit": "final_ascent", "exit_if": "dragging", "locked": "mountain.not_without" }
        ]
    },

    "final_ascent": {
        "name": "The Final Ascent",
        "background": "backgrounds/mountain_steps.png",
        "color": "#22222c",
        "tint": "#8a8ca8",
        "ambient": ["wind", "footsteps"],
        "script": "sunset",
        "player_x": 24,
        "companion": { "mode": "drag" },
        "objects": [
            { "id": "rest_bench", "name": "Stone bench", "x": 70, "y": 140, "w": 30, "h": 10, "color": "#3a3a44",
              "rest": true, "if": "dragging", "once": true, "dialogue": "mountain.rest" },
            { "id": "talk", "x": 140, "w": 16, "h": 60, "trigger": true, "dialogue": "ascent.talk" },
            { "id": "summit_path", "name": "The summit", "x": 304, "y": 60, "w": 16, "h": 90, "color": "#15151c",
              "exit": "summit", "exit_if": "dragging", "locked": "mountain.not_without" }
        ]
    }
}
