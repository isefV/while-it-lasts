// STAGE 03 rooms. All use the one mountain background: the foot as drawn,
// every level after it mirrored. Audio rule: each screen loses one ambient
// layer; the final ascent has only wind and footsteps. The footsteps are
// theirs: "steps" plays one on each footfall of the walk and drag
// animations, instead of a loop.
// The Reaper: at the foot and at the collapse it stalks them ("reaper
// stalk": it shows up, fades, and shows up again a little closer); at the
// broken stairs it stays away; on the final ascent it chases them ("reaper
// chase"): standing still lets it catch up, and a catch hurts both.
{
    "foot": {
        "name": "Foot of the Mountain",
        "background": "backgrounds/mountain_steps.png",
        "frame": true,
        "color": "#182027",
        "tint": "#9fa8bc",
        "fog": 1,
        "ambient": ["wind", "leaves", "insects", "stream"],
        "steps": ["step_1", "step_2", "step_3"],
        "music": "music_mountain",
        "player_x": 24,
        "idle_barks": ["y_idle", "x_idle_good", "x_idle_weak", "x_reaper"],
        // Arriving from the barricade, Y drags X in and sets him down here (what
        // was the Sheltered Wall): the crushed pack's cigarette is smoked or
        // saved before the climb. shelter.go then plays foot.arrive and the
        // Reaper starts stalking. (The First Landing is part of this level now.)
        "enter": [
            { "if": "!stage02_done", "dialogue": "shelter.arrive" },
            { "if": "stage02_done", "do": ["reaper stalk"], "once": false }
        ],
        "companion": { "mode": "follow", "bark": "x_idle_good" },
        "objects": [
            { "id": "lantern_1", "name": "Stone lantern", "x": 54, "y": 116, "w": 16, "h": 32, "color": "#2e343e",
              "sprite": "props/lantern.png", "dialogue": "foot.lantern" },
            { "id": "fire_ring", "name": "Old fire ring", "x": 86, "y": 119, "w": 32, "h": 32, "color": "#2a2826",
              "sprite": "props/bonfire_dead.png", "dialogue": "shelter.ring" },
            { "id": "lantern", "name": "Mossy lantern", "x": 140, "y": 119, "w": 16, "h": 32, "color": "#3a4438",
              "sprite": "props/lantern.png", "dialogue": "landing.lantern" },
            { "id": "crushed_pack", "name": "Crushed pack", "x": 190, "y": 136, "w": 16, "h": 16, "color": "#6a6458",
              "sprite": "props/cigarette_pack_crushed.png", "if": "!wall_pack_found", "dialogue": "shelter.pack" },
            { "id": "broken_sign", "name": "Broken sign", "x": 232, "y": 120, "w": 32, "h": 32, "color": "#4a4236",
              "sprite": "props/broken_sign.png", "dialogue": "landing.sign" },
            { "id": "steps", "name": "Stone steps", "x": 300, "y": 70, "w": 20, "h": 80, "color": "#11161c", "hidden": true,
              "exit": "collapse", "exit_if": "stage02_done", "locked": "shelter.not_yet" }
        ]
    },

    "collapse": {
        "name": "The Collapse",
        "background": "backgrounds/mountain_steps.png",
        "flip": true,
        "frame": true,
        "color": "#1b1f27",
        "tint": "#9a9fb4",
        "fog": 1,
        "ambient": ["wind", "leaves"],
        "steps": ["step_1", "step_2", "step_3"],
        "music": "music_mountain",
        "player_x": 40,
        "idle_barks": ["x_idle_weak", "x_reaper"],
        // After the near-death scene, collapse.revived starts the stalking.
        "enter": [
            { "dialogue": "collapse.fall" }
        ],
        "companion": { "mode": "follow" },
        "objects": [
            { "id": "rest_rock", "name": "Flat rock", "x": 96, "y": 142, "w": 26, "h": 8, "hidden": true, "color": "#3a3f47",
              "rest": true, "if": "dragging", "once": true, "dialogue": "mountain.rest" },
            { "id": "narrow", "x": 158, "w": 6, "h": 60, "hidden": true, "block": "dragging && !turned_x",
              "blocked": "collapse.narrow" },
            { "id": "rest_stump", "name": "Tree stump", "x": 236, "y": 140, "w": 18, "h": 10, "hidden": true, "color": "#3a3530",
              "rest": true, "if": "dragging", "once": true, "dialogue": "mountain.rest" },
            { "id": "steps", "name": "Stone steps", "x": 300, "y": 70, "w": 20, "h": 80, "color": "#11161c", "hidden": true,
              "exit": "broken_stairs", "exit_if": "dragging", "locked": "mountain.not_without" }
        ]
    },

    "broken_stairs": {
        "name": "The Broken Stairs",
        "background": "backgrounds/mountain_steps.png",
        "flip": true,
        "frame": true,
        "color": "#1c1e26",
        "tint": "#9a9aae",
        "fog": 1,
        "ambient": ["wind", "groan"],
        "steps": ["step_1", "step_2", "step_3"],
        "music": "music_mountain",
        "script": "creature",
        "player_x": 36,
        "idle_barks": ["x_idle_weak", "y_hurt"],
        // No way round it and no Reaper here: Y can't drag X past the low wall,
        // so he leaves him behind it (G), and walking up to the creature starts
        // the fight: two crawlers up the path behind first (for X, if he is not
        // behind the wall), then the creature itself.
        "companion": { "mode": "drag", "dialogue": "stairs.x", "release": "stairs.release", "grab": "stairs.grab" },
        "creature": {
            "if": "!creature_cleared", "x": 226, "y": 150, "w": 34, "h": 54, "speed": 30,
            "color": "#0b0d11", "sprite": "sprites/creature.json"
        },
        "fight": {
            "brute": true, "hp": 12, "damage": 3,
            "waves": [ { "crawlers": 2, "from": "left" } ],
            "win": "stairs.fight_won"
        },
        "objects": [
            { "id": "low_wall", "x": 60, "y": 135, "w": 64, "h": 16, "color": "#2c3139", "sprite": "props/beam_2.png", "interactive": false, "front": true,
              "cover": true },
            { "id": "safe_spot", "x": 98, "w": 14, "h": 60, "trigger": true, "if": "dragging && !creature_cleared",
              "dialogue": "stairs.safe_hint" },
            { "id": "no_drag", "x": 132, "w": 4, "h": 60, "hidden": true, "block": "dragging && !creature_cleared",
              "blocked": "stairs.cant_drag" },
            { "id": "creature", "x": 192, "w": 12, "h": 60, "trigger": true, "if": "!creature_cleared && !dragging",
              "dialogue": "stairs.fight" },
            { "id": "creature_block", "x": 216, "w": 4, "h": 60, "hidden": true, "block": "!creature_cleared" },
            { "id": "fallen_beam", "name": "Fallen beam", "x": 246, "y": 134, "w": 64, "h": 16, "color": "#3a3128",
              "sprite": "props/beam_1.png", "if": "!beam_moved", "block": "!beam_moved", "dialogue": "stairs.beam" },
            { "id": "rest_step", "name": "Mossy step", "x": 262, "y": 144, "w": 22, "h": 6, "hidden": true, "color": "#34403a",
              "rest": true, "if": "dragging && beam_moved", "once": true, "dialogue": "mountain.rest" },
            { "id": "steps", "name": "Stone steps", "x": 304, "y": 70, "w": 16, "h": 80, "color": "#11161c", "hidden": true,
              "exit": "final_ascent", "exit_if": "dragging", "locked": "mountain.not_without" }
        ]
    },

    "final_ascent": {
        "name": "The Final Ascent",
        "background": "backgrounds/mountain_steps.png",
        "flip": true,
        "frame": true,
        "color": "#22222c",
        "tint": "#8a8ca8",
        "fog": 1,
        "ambient": ["wind"],
        "steps": ["step_1", "step_2", "step_3"],
        "script": "sunrise",
        "player_x": 24,
        // The Reaper chases them: keep moving, or it catches up and hurts both.
        "enter": [
            { "do": ["reaper chase 110"], "once": false }
        ],
        "companion": { "mode": "drag" },
        "objects": [
            { "id": "rest_bench", "name": "Stone bench", "x": 70, "y": 140, "w": 30, "h": 10, "hidden": true, "color": "#3a3a44",
              "rest": true, "if": "dragging", "once": true, "dialogue": "mountain.rest" },
            { "id": "talk", "x": 140, "w": 16, "h": 60, "trigger": true, "dialogue": "ascent.talk" },
            { "id": "sky", "name": "The sky", "x": 200, "y": 14, "w": 60, "h": 24, "hidden": true,
              "dialogue": "ascent.sky" },
            { "id": "summit_path", "name": "The summit", "x": 304, "y": 60, "w": 16, "h": 90, "color": "#15151c", "hidden": true,
              "exit": "summit", "exit_if": "dragging", "locked": "mountain.not_without" }
        ]
    }
}
