// STAGE 04: the summit. After the cigarette the player may look at the
// horizon, X or the cigarette; the room's script starts the Reaper scene
// after two of those, or after half a minute.
{
    "summit": {
        "name": "The Summit",
        "background": "backgrounds/summit.png",
        "frame": true,
        "color": "#26242e",
        "tint": "#e6c6ae",
        "ambient": ["wind"],
        "script": "summit",
        "player_x": 112,
        "walk": [100, 150],
        "enter": [
            { "dialogue": "summit.arrive" }
        ],
        "companion": { "x": 162, "mode": "stay", "pose": "sit", "dialogue": "summit.x" },
        "objects": [
            { "id": "horizon", "name": "Horizon", "x": 96, "y": 24, "w": 220, "h": 70, "hidden": true,
              "if": "cig_scene_done", "dialogue": "summit.horizon" },
            { "id": "cigarette", "name": "Cigarette", "x": 152, "y": 124, "w": 2, "h": 2, "color": "#d8d2c4",
              "effect": "ember", "if": "cig_lit && !ember_out && !cig_held", "dialogue": "summit.cigarette" }
        ]
    }
