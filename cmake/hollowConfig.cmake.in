# -----------------------------------------------------------------------------
# hollowConfig.cmake - CMake package for an installed hollow.
#
#   find_package(hollow CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE hollow::hollow)
#
# Provides:
#
#   hollow::hollow           the library (static)
#
#   hollow_SOURCE_ROOT      this package's folder. The library's debug info
#                          names its sources /hollow/src/... (MSVC:
#                          \hollow\src\...); a Debug package ships them in src/
#                          here, so map /hollow to this folder in your debugger
#                          to step into hollow
#
# Dependencies are found again here, with the find modules the library's own
# build uses (Threads: CMake's own; Raylib: FindRaylib.cmake, installed beside
# this file). raylib is linked to hollow::hollow here rather than in the
# exported targets, because the build compiles raylib as part of itself.
# nlohmann/json is header-only and private to the library's .cpp files.
# -----------------------------------------------------------------------------

@PACKAGE_INIT@

set(hollow_SOURCE_ROOT "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(Threads)
find_dependency(Raylib)

if(NOT TARGET hollow::hollow)
    include("${CMAKE_CURRENT_LIST_DIR}/hollowTargets.cmake")
    target_link_libraries(hollow::hollow INTERFACE raylib)
endif()

check_required_components(hollow)
